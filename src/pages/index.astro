---
import Layout from '../layouts/Layout.astro';
import BentoGallery from '../components/BentoGallery.astro';
---

<Layout title="GRUFOS | Colectivo Fotográfico">
  <div class="home-hero">
    <span class="section-label">Colectivo Fotográfico Independiente</span>
    <h1 class="home-title">La mirada compartida a través de la luz y el espacio.</h1>
  </div>
  <BentoGallery />
</Layout>

<style>
  .home-hero {
    text-align: center;
    max-width: 860px;
    margin: 3.5rem auto 1.5rem;
    padding: 0 1.5rem;
  }

  .home-title {
    font-size: clamp(1.75rem, 3.5vw, 2.85rem);
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: -0.025em;
    color: #f4f4f5;
    margin: 0.75rem 0 0;
  }

  @media (max-width: 640px) {
    .home-hero {
      margin: 2.25rem auto 1rem;
    }
  }
</style>
