---
import '../../styles/pages/photographers.scss';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PhotographerCard from '../../components/PhotographerCard.tsx';

const photographers = await getCollection('photographers');
---

<Layout title="Fotógrafos | GRUFOS">
  <div class="photographers-header">
    <span class="section-label">Colectivo GRUFOS</span>
    <h1 class="page-title">Nuestros Fotógrafos</h1>
    <p class="section-desc">
      Artistas visuales independientes dedicados a capturar la esencia de diferentes perspectivas del mundo.
    </p>
  </div>

  <div class="photographers-grid">
    {photographers.map((photographer) => (
      <PhotographerCard
        photographer={{
          name: photographer.data.name,
          uniqueId: photographer.data.uniqueId,
          image: photographer.data.image,
          location: photographer.data?.location || '',
        }}
        client:load
      />
    ))}
  </div>
</Layout>
