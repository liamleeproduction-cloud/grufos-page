---
import '../styles/components/Footer.scss';
import { InstagramIcon, FacebookIcon, TwitterIcon, YoutubeIcon } from 'astro-feather';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <h3 class="footer-logo">GRUFOS</h3>
        <p class="footer-desc">
          Por la pasión a la fotografía. Colectivo artístico dedicado a explorar la luz, el espacio y la narrativa visual independiente.
        </p>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Navegación</h4>
        <ul class="footer-links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/fotografos">Fotógrafos</a></li>
          <li><a href="/acerca">Acerca de</a></li>
          <li><a href="/login">Acceso Miembros</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Comunidad</h4>
        <ul class="footer-links">
          <li><a href="/fotografos">Directorio</a></li>
          <li><a href="/perfil">Panel de Fotógrafo</a></li>
          <li><a href="/acerca">Manifiesto</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Síguenos</h4>
        <div class="footer-social">
          <a href="#" aria-label="Instagram"><InstagramIcon /></a>
          <a href="#" aria-label="Facebook"><FacebookIcon /></a>
          <a href="#" aria-label="Twitter"><TwitterIcon /></a>
          <a href="#" aria-label="Youtube"><YoutubeIcon /></a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Colectivo GRUFOS. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
